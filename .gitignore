# Dependencies
node_modules/

# Build output
dist/

# Environment (never commit secrets). Ignore .env and EVERY variant
# (.env.local, .env.production, .env.bak.*, ...) except the committed template.
.env
.env.*
!.env.example

# Prisma generated client (regenerate with `pnpm db:generate`)
**/generated/

# Prisma-generated SQL schema dump (regenerate with `pnpm db:schema:sql`)
docs/schema.sql

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Self-hosted Mushaf page images (download with `pnpm data:mushaf`). The image
# files are too large to commit, but the manifest of SHA-256 fingerprints IS
# tracked so the set can be re-verified offline (`pnpm data:mushaf --check`).
assets/mushaf/*.jpg
assets/mushaf/*.png
# Per-riwayah image sets (e.g. assets/mushaf/warsh-asbahani/*.jpg) are just as
# large, so ignore every subfolder's images too. The top-level manifest stays tracked.
assets/mushaf/*/
# The tajweed example clips (assets/tajweed/*.mp3, ~8 MB) ARE committed on
# purpose, so they bake into the image and ship with the code. Not ignored.

# Self-hosted per-page recitation set (build with `pnpm data:page-audio`). Far
# too large to commit (~2 GB per reciter); lives in /opt/bots/data on the server.
assets/page-audio/
# assets/audio-cover.jpg (the clip cover the generator embeds) IS committed as a
# placeholder, so data:page-audio works out of the box. Replace it with your own.

# Logs
*.log

# Claude Code
.claude/
