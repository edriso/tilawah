# =====================================================================
#  Tilawah bot configuration
#
#  Copy this single file to ".env" in this same folder, then fill it in:
#      cp .env.example .env
#
#  Every package and script in the project reads this one root .env, so
#  there is only one file to manage. Each variable below shows what it is,
#  an Example, and any Best practice. The REQUIRED ones come first.
# =====================================================================


# REQUIRED  -  Telegram bot token from @BotFather.
# The bot will not start without it. Treat it like a password.
# How to get it: open @BotFather in Telegram, send /newbot (or /mybots for
# an existing bot), and copy the token it gives you.
# Example:  BOT_TOKEN="123456789:AAFakeExampleTokenFromBotFather_xxx"
BOT_TOKEN=""


# REQUIRED  -  MySQL/MariaDB connection string.
# Tilawah keeps each reader's place in the Quran in this database, so it is
# required for both the channel and the personal bot. Create the database
# first, then put its connection string here. The same value is used by the
# bot, the Prisma CLI, the seed, and the fetch script.
#   Local:       mysql://tilawah:password@localhost:3306/tilawah
#   Production:  mysql://user:password@host:3306/tilawah
# If your password has special characters (@ : / etc.), URL-encode them.
DATABASE_URL="mysql://tilawah:password@localhost:3306/tilawah"


# OPTIONAL  -  The channel Tilawah posts the daily wird to.
# Set this to run the public channel. It can be a numeric chat id (the usual
# form for a channel, like -1001234567890) or a public @username. Add the bot
# to the channel as an admin that can post. Leave empty to run without a
# channel (personal bot only).
# How to get the id: forward a channel post to @userinfobot, or read it from
# the Bot API. A public channel can also be given as "@yourchannel".
# Example:  CHANNEL_CHAT_ID="-1001234567890"
CHANNEL_CHAT_ID=""


# OPTIONAL  -  Numeric Telegram user ids allowed to run the admin commands,
# separated by commas. Admins control the channel: set the last page read,
# change its wird size, time, days, and pause or resume it. Admin commands
# only work in a private chat with the bot. Leave empty to disable them.
# How to get an id: message @userinfobot on Telegram.
# Example:  ADMIN_TELEGRAM_IDS="123456789,987654321"
ADMIN_TELEGRAM_IDS=""


# OPTIONAL  -  Turn the personal user bot on or off. "true" (the default)
# lets any user register and get their own wird. Set "false" for a
# channel-only deployment: the bot then politely declines personal wird
# commands and the scheduler serves the channel only.
# Example:  USER_WIRD_ENABLED="true"
USER_WIRD_ENABLED="true"


# OPTIONAL  -  Default timezone for brand-new subscribers and the channel
# (IANA name). Each user can change their own later with /timezone; this is
# only the starting value. Falls back to UTC if left empty, so set it to your
# main audience's timezone. The bot validates it at boot and refuses to start
# on a typo, so you find out right away.
# Example:  TZ_NAME="Africa/Cairo"   (others: "Europe/London", "Asia/Riyadh")
TZ_NAME="Africa/Cairo"


# OPTIONAL  -  How the "image" delivery format finds each Mushaf page. Image is
# the DEFAULT format: a daily page is sent as a picture of the actual Mushaf
# page. The value is a TEMPLATE with {page} (raw number, e.g. 25) or {page3}
# (zero-padded to 3 digits, e.g. 025). It can be EITHER:
#
#   * a LOCAL FILE PATH  ->  the bot uploads the page from disk (recommended,
#     and the only option for a bot with no public URL). You download + verify
#     the 604 images once with `pnpm data:mushaf`, eyeball a few, then put them
#     on the server (see docs/DEPLOY.md, "Self-hosting"). In Docker the path is
#     the volume/bind mount point, which is this default:
#         /app/assets/mushaf/{page3}.jpg
#
#   * an http(s) URL     ->  Telegram fetches the page from that host, e.g.
#       https://raw.githubusercontent.com/QuranHub/quran-pages-images/main/easyquran.com/hafs-tajweed/{page}.jpg  (colored tajweed)
#       https://tafsir.app/scans/m-madinah/{page}.png               (colored, 1064x1713)
#       https://android.quran.com/data/width_1260/page{page3}.png   (grayscale)
#
# Each page is sent to Telegram once, then re-sent by the cached file_id. If a
# page is missing (the file is not there, or the URL is unreachable) the bot
# quietly sends THAT page as text, so the wird always goes out. Leave EMPTY to
# run text-only (no images at all).
# IMPORTANT: like the text, these images are the holy Quran, so use only a
# VERIFIED Madani Mushaf (604 pages, the standard 15-line King Fahd layout).
MUSHAF_IMAGE_BASE_URL="/app/assets/mushaf/{page3}.jpg"


# OPTIONAL  -  Source for the DAILY TAJWEED LESSON's example audio. The bot
# posts a short tajweed lesson right before each wird (on by default; readers
# toggle it with /tajweed, the channel admin with /admin_tajweed). Each lesson
# names an example ayah whose verified text comes from the database; this is the
# recitation CLIP for that ayah. It is a template with {surah}/{ayah} (or
# zero-padded {surah3}/{ayah3}) placeholders.
#
# The ~33 example clips (Husary murattal) are committed to the repo and BAKED
# INTO the image (only 8 MB, unlike the 90 MB Mushaf set which is volume-mounted),
# so the default below works out of the box once deployed:
TAJWEED_AUDIO_BASE_URL="/app/assets/tajweed/{surah3}{ayah3}.mp3"
# Alternatives:
#   * leave EMPTY to send lessons WITHOUT audio (text + example ayah only)
#   * an http(s) URL Telegram fetches, e.g. the Husary set on everyayah.com:
#       https://everyayah.com/data/Husary_128kbps/{surah3}{ayah3}.mp3
# Refresh/re-verify the local clips any time with `pnpm data:tajweed [--check]`.


# OPTIONAL  -  Source for the per-PAGE recitation (the audio sent after a user's
# wird, in their chosen reciter). It is a template with a {folder} placeholder
# (the reciter's data folder) and a {page}/{page3} placeholder. It may be a local
# path (the bot uploads the file) or an http(s) URL (Telegram fetches it).
#
# Leave EMPTY to use everyayah's pre-split PageMp3s. That works, but those files
# are NOT ayah-verified: some pages are defective (e.g. Abdul Basit's Page011
# drops verse 2:76) and all carry junk tags and no cover art. For production,
# build a VERIFIED self-hosted set (one clip per page, concatenated from the
# trusted per-ayah clips for exactly our Madani page layout, with clean tags and
# a cover) and point this at it:
#   pnpm data:page-audio --cover assets/audio-cover.jpg   # build it (needs ffmpeg)
#   pnpm verify:audio --dir assets/page-audio             # confirm it is complete
# then rsync assets/page-audio/ to /opt/bots/data/tilawah/page-audio/ and set:
PAGE_AUDIO_BASE_URL="/app/assets/page-audio/{folder}/Page{page3}.mp3"


# OPTIONAL  -  Runtime mode. This template defaults to "production" because a
# copied .env is normally used to RUN the bot. Production quietens debug logs
# and keeps a single database pool. You do NOT need to change this for local
# work: `pnpm dev` always runs in development mode no matter what is set here.
NODE_ENV="production"


# OPTIONAL  -  HTTP port for the /health endpoint. Defaults to 8080. Many
# hosts inject their own PORT automatically, so you usually leave this empty.
# A blank or invalid value safely falls back to 8080.
# Example:  PORT="8080"
PORT=""


# OPTIONAL  -  Override the Quran text download URL used by `pnpm data:fetch`.
# Leave empty to use the built-in Tanzil Uthmani "Text (with aya numbers)"
# link. Only set this if Tanzil ever changes its URL; the value must point to
# a Tanzil Uthmani text-with-aya-numbers download. Whatever you set is still
# verified (6236 ayat, correct count per surah) before anything is written.
QURAN_SOURCE_URL=""


# OPTIONAL  -  Override the page and juz boundary source used by
# `pnpm data:fetch`. Leave empty to use the built-in Al Quran Cloud metadata
# endpoint. Whatever you set must return the same shape (604 page references
# and 30 juz references); it is verified before anything is written.
QURAN_META_URL=""
